# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_VERSION=v1
# Comma-separated list of origins allowed by CORS. Never use * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# Must be a replica set for multi-document transactions (checkout). The bundled
# docker-compose.yml starts a single-node replica set named rs0.
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/shopcore?replicaSet=rs0&directConnection=true

# ---------------------------------------------------------------------------
# Redis (cache, rate-limit store, BullMQ broker)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# JWT — generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_EXPIRY=7d

# ---------------------------------------------------------------------------
# Email — leave SMTP_HOST blank to auto-create an Ethereal test account.
# Preview URLs are printed to the log; no real mail is sent in development.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@shopcore.dev

# ---------------------------------------------------------------------------
# File uploads (local provider)
# ---------------------------------------------------------------------------
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
PUBLIC_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ---------------------------------------------------------------------------
# Security / business rules
# ---------------------------------------------------------------------------
BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFY_EXPIRY_HOURS=24

# ---------------------------------------------------------------------------
# Payments (mock provider). The webhook is HMAC-signed with this secret.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-me-with-a-random-webhook-secret

# ---------------------------------------------------------------------------
# Caching (seconds)
# ---------------------------------------------------------------------------
CACHE_TTL_PRODUCT_LIST=300
CACHE_TTL_PRODUCT_DETAIL=300
CACHE_TTL_CATEGORY_TREE=3600

# ---------------------------------------------------------------------------
# Inventory
# ---------------------------------------------------------------------------
LOW_STOCK_THRESHOLD=5
